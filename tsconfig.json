{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components": [
        "./components"
      ],
      "@/app": [
        "./app"
      ],
      "@/constants": [
        "./constants"
      ],
      "@/utils": [
        "./utils"
      ],
      "@/hooks": [
        "./hooks"
      ],
      "@/types": [
        "./types"
      ],
      "@/services": [
        "./services"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}